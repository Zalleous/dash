{
	"name": "dash",
	"private": true,
	"version": "0.0.1",
	"description": "A one-screen homelab and day dashboard: calendar, vault, Proxmox, media, uptime and more, each panel fed by its own source.",
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"type": "module",
	"scripts": {
		"dev": "node --env-file-if-exists=.env node_modules/vite/bin/vite.js dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node --env-file-if-exists=.env build",
		"panel": "node scripts/panel.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"devDependencies": {
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^24",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@fontsource-variable/host-grotesk": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@fontsource-variable/tektur": "^5.3.0",
		"gsap": "^3.15.0",
		"node-ical": "^0.27.3"
	}
}
