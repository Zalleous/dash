# Copy to .env and fill in what you use. npm run dev and npm start load it (node --env-file-if-exists=.env), and
# Docker Compose passes it through env_file. A variable already set in the environment wins over this file.
# Every key is optional: a panel whose keys are missing shows n/c and names them in its tooltip.

# --- General ---

# The server's time zone: what "today" and "this week" mean for todos, the daily note, the timer and the calendar.
# The page clock uses the browser's time zone.
TZ=UTC
# The name in the page title and, lowercased, in the header. Default SYS://DASH.
DASH_NAME=
# The SQLite file for settings, presets, the timer and the uptime history. Its folder must exist.
DB_PATH=dash.db
# The link list (Ctrl+K, uptime probes, media links). Default ./links.json; see links.example.json.
LINKS_FILE=links.json
# A PEM file of extra CA certificates, for services with a private CA or a self-signed certificate.
# Node reads it only from the real environment: npm start and npm run dev ignore it here. Export it in your shell or
# service instead. Docker Compose passes it as a real variable, so it works there (mount the file too).
# NODE_EXTRA_CA_CERTS=/path/to/ca.pem

# --- Calendar: now and next, agenda, deadlines ---

# ICS feed URLs, separated by spaces. The order only picks each feed's colour.
# CAL_ICS=https://calendar.example.lan/personal.ics https://calendar.example.lan/work.ics
CAL_ICS=

# --- Gitea and the vault: todo, deadlines, focus, dev, Ctrl+K todo: and log: ---

GITEA_URL=https://gitea.example.lan
# A Gitea access token. It reads your repositories and writes to VAULT_REPO.
GITEA_TOKEN=
# The vault's repo, as owner/name.
VAULT_REPO=you/vault
# Folders in VAULT_REPO (these are the defaults): kanban boards, project notes, daily notes (YYYY-MM-DD.md).
VAULT_BOARDS=boards
VAULT_PROJECTS=wiki/projects
VAULT_DAILY=wiki/daily
# The focus panel's weekly goal: no goal without GOAL_PROJECT. GOAL_HOURS defaults to 10.
GOAL_PROJECT=
GOAL_HOURS=10

# --- Homelab ---

# Proxmox VE: cpu, mem and the guests. Token as user@realm!tokenid=secret; a read-only role such as PVEAuditor is enough.
PVE_URL=https://192.168.1.2:8006
PVE_TOKEN=
# Glances 4: the CPU temperature (the sensor whose label starts with Package).
# GLANCES_URL=http://192.168.1.2:61208
GLANCES_URL=
# Optional: VMs that run Glances, as space-separated vmid=url pairs; their memory is read there, not from Proxmox.
# GLANCES_VMS=100=http://192.168.1.3:61208 101=http://192.168.1.4:61208
GLANCES_VMS=
# Serves vpn-status.json and threat-status.json (see README). No trailing slash.
GUARDS_URL=
# Pi-hole v6 and its app password.
PIHOLE_URL=http://192.168.1.5
PIHOLE_PASSWORD=
# TrueNAS pools. Must be https: TrueNAS revokes an API key used over plain http.
TRUENAS_URL=https://192.168.1.6
TRUENAS_KEY=
# WGDashboard and an API key.
WGDASH_URL=http://192.168.1.7:10086
WGDASH_KEY=

# --- Media ---

# Sonarr and Radarr: this week and the download queue. Both are needed. Keys are in each app's settings.
SONARR_URL=http://192.168.1.8:8989
SONARR_KEY=
RADARR_URL=http://192.168.1.8:7878
RADARR_KEY=
# Jellyseerr: open requests.
JELLYSEERR_URL=http://192.168.1.8:5055
JELLYSEERR_KEY=
# Jellyfin: what is playing and the latest added. JELLYFIN_USER picks whose latest; default the first administrator.
JELLYFIN_URL=http://192.168.1.9:8096
JELLYFIN_KEY=
JELLYFIN_USER=

# --- Server (adapter-node) ---

# HOST=0.0.0.0
# PORT=3000

# --- deploy/deploy.sh only ---

# The Proxmox node's ssh host and the container id. deploy.sh leaves these and NODE_EXTRA_CA_CERTS out of
# /etc/dash.env on the server.
# DEPLOY_SSH=root@192.168.1.2
# DEPLOY_CT=120
DEPLOY_SSH=
DEPLOY_CT=
